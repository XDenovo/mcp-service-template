from __future__ import annotations

import os
import subprocess
import sys


def test_package_and_service_import_without_runtime_configuration() -> None:
    environment = {
        name: value for name, value in os.environ.items() if not name.startswith("MCP_RUNTIME_")
    }

    completed = subprocess.run(
        [
            sys.executable,
            "-c",
            "import {{ package_name }}; import {{ package_name }}.service",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
    )

    assert completed.returncode == 0, completed.stderr
