[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
authors = [
    { name = "XDenovo" },
]
requires-python = ">={{ python_version }},<{{ python_next_version }}"
dependencies = [
    "fastmcp[apps]>={{ fastmcp_version }},<4",
    "httpx>={{ httpx_version }},<1",
    "mcp-runtime @ git+https://github.com/XDenovo/mcp-runtime.git@{{ mcp_runtime_version }}",
]

[build-system]
requires = ["uv_build>={{ uv_build_version }},<0.12.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "prek=={{ prek_version }}",
    "pytest=={{ pytest_version }}",
    "pytest-asyncio=={{ pytest_asyncio_version }}",
    "ruff=={{ ruff_version }}",
    "ty=={{ ty_version }}",
]

[tool.uv]
required-version = "=={{ uv_version }}"

[tool.pytest]
minversion = "{{ pytest_version }}"
addopts = ["-ra", "--import-mode=importlib"]
testpaths = ["tests"]
required_plugins = ["pytest-asyncio=={{ pytest_asyncio_version }}"]
strict = true
filterwarnings = ["error"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
asyncio_default_test_loop_scope = "function"

[tool.ruff]
target-version = "{{ ruff_python_target }}"
line-length = 100

[tool.ruff.lint]
select = ["B", "E", "F", "I", "RUF", "SIM", "UP"]

[tool.ruff.format]
indent-style = "space"
line-ending = "lf"
quote-style = "double"
