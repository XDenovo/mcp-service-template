[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
authors = [
    { name = "XDenovo" },
]
requires-python = ">=3.13,<3.14"
dependencies = [
    "fastmcp[apps]>=3.4.4,<4",
    "httpx>=0.28.1,<1",
    "mcp-runtime @ git+https://github.com/XDenovo/mcp-runtime.git@v0.2.0",
]

[build-system]
requires = ["uv_build>=0.11.30,<0.12.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "prek>=0.4.10,<0.5",
    "pytest>=9.1.1,<10",
    "pytest-asyncio>=1.4.0,<2",
    "ruff>=0.15.22,<0.16",
    "ty>=0.0.61,<0.1",
]

[tool.uv]
required-version = "==0.11.30"

[tool.pytest]
addopts = ["-ra", "--import-mode=importlib"]
testpaths = ["tests"]
required_plugins = ["pytest-asyncio"]
strict = true
filterwarnings = ["error"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
asyncio_default_test_loop_scope = "function"

[tool.ruff]
target-version = "py313"
line-length = 100

[tool.ruff.lint]
select = ["B", "E", "F", "I", "RUF", "SIM", "UP"]

[tool.ruff.format]
indent-style = "space"
line-ending = "lf"
quote-style = "double"
